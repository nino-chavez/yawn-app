{
  "$schema": "./tokens.schema.json",
  "meta": {
    "namespace": "yawn",
    "colorFormat": "hex-rgba",
    "rationale": "Yawn's colors are authored per-appearance (light/dark) hex and rgba constants approximating macOS system semantic colors (DESIGN.md §Color) — not derived from a single brand triplet the way Minder's OKLCH roles are. This file follows Minder's tokens.json schema shape (packages/design-tokens/tokens.json in the Minder repo) so both apps hold tokens the same way; none of the values are shared. See DESIGN.md for value authority and apps/desktop/ui/tokens.css for the generated, consumed form."
  },
  "color": {
    "accent": { "light": "#0a60ff", "dark": "#0a84ff" },
    "record": { "light": "#e5372c", "dark": "#ff453a" },
    "attention": { "light": "#b7791f", "dark": "#ffd60a" },
    "attentionBackground": { "light": "rgba(255,214,10,0.14)", "dark": "rgba(255,214,10,0.10)" },
    "evidence": { "light": "rgba(10,96,255,0.10)", "dark": "rgba(10,132,255,0.16)" },
    "neutral": {
      "window": { "light": "#ececec", "dark": "#1e1e1e" },
      "sidebar": { "light": "#e8e8e8", "dark": "#232323" },
      "content": { "light": "#ffffff", "dark": "#1e1e1e" },
      "panel": { "light": "#f5f5f5", "dark": "#2a2a2a" },
      "separator": { "light": "rgba(0,0,0,0.12)", "dark": "rgba(255,255,255,0.10)" },
      "separatorStrong": { "light": "rgba(0,0,0,0.2)", "dark": "rgba(255,255,255,0.18)" },
      "label": { "light": "#1d1d1f", "dark": "#f2f2f2" },
      "label2": { "light": "rgba(29,29,31,0.62)", "dark": "rgba(242,242,242,0.62)" },
      "label3": { "light": "rgba(29,29,31,0.40)", "dark": "rgba(242,242,242,0.40)" },
      "control": { "light": "#ffffff", "dark": "#3a3a3a" },
      "controlBorder": { "light": "rgba(0,0,0,0.16)", "dark": "rgba(255,255,255,0.10)" },
      "controlShadow": { "light": "0 0.5px 1px rgba(0,0,0,0.12)", "dark": "0 0.5px 1px rgba(0,0,0,0.4)" },
      "selection": { "light": "rgba(0,0,0,0.06)", "dark": "rgba(255,255,255,0.07)" },
      "selectionActive": { "light": "#0a60ff", "dark": "#0a84ff" },
      "onSelection": { "light": "#ffffff", "dark": "#ffffff" }
    },
    "contrastMore": {
      "separator": { "light": "rgba(0,0,0,0.32)", "dark": "rgba(255,255,255,0.32)" },
      "separatorStrong": { "light": "rgba(0,0,0,0.5)", "dark": "rgba(255,255,255,0.5)" },
      "label2": { "light": "rgba(29,29,31,0.82)", "dark": "rgba(242,242,242,0.85)" },
      "label3": { "light": "rgba(29,29,31,0.62)", "dark": "rgba(242,242,242,0.65)" }
    }
  },
  "font": {
    "body": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, monospace"
  },
  "fontSize": {
    "caption": { "size": "11px" },
    "body": { "size": "13px", "lineHeight": "1.4" },
    "transcript": { "size": "14px", "lineHeight": "1.55" },
    "read": { "size": "15px", "lineHeight": "1.6" },
    "title": { "size": "17px" },
    "large": { "size": "22px" }
  },
  "measure": "62ch",
  "spacing": {
    "4": "4px",
    "6": "6px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "18": "18px",
    "24": "24px",
    "32": "32px",
    "48": "48px"
  },
  "radius": {
    "control": "6px",
    "card": "10px"
  },
  "motion": {
    "duration": { "fast": "120ms", "standard": "200ms" },
    "easing": { "standard": "ease-out" },
    "default": "160ms ease-out",
    "reduced": "0ms"
  },
  "layout": {
    "toolbar": "52px",
    "sidebar": "280px",
    "inspector": "320px",
    "control": { "default": "22px", "attention": "26px" }
  }
}
