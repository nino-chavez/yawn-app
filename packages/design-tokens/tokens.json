{
  "$schema": "./tokens.schema.json",
  "meta": {
    "namespace": "yawn",
    "colorFormat": "hex-rgba",
    "rationale": "Yawn's Tonal Ledger colors are authored directly per appearance (DESIGN.md Color), not derived from a brand triplet or copied from Minder. This file follows Minder's tokens.json schema shape so both apps hold tokens the same way; none of the values are shared. See DESIGN.md for value authority and apps/desktop/ui/tokens.css for the generated, consumed form."
  },
  "color": {
    "accent": { "light": "#6855a9", "dark": "#b8a7ce" },
    "onAccent": { "light": "#ffffff", "dark": "#27212f" },
    "record": { "light": "#b74640", "dark": "#e5a19c" },
    "onRecord": { "light": "#ffffff", "dark": "#27212f" },
    "attention": { "light": "#9a641c", "dark": "#d6b886" },
    "attentionBackground": { "light": "#fff1dc", "dark": "#3d352a" },
    "evidence": { "light": "#e7e0f2", "dark": "#3b3349" },
    "neutral": {
      "window": { "light": "#e4e0e7", "dark": "#26242e" },
      "sidebar": { "light": "#dfdbe3", "dark": "#22212a" },
      "content": { "light": "#faf8fb", "dark": "#2c2a35" },
      "panel": { "light": "#e9e5ec", "dark": "#302d39" },
      "notes": { "light": "#f3f0f5", "dark": "#302e3a" },
      "notesBorder": { "light": "#d8d1dc", "dark": "#47424f" },
      "separator": { "light": "#d4ced8", "dark": "#3e3a47" },
      "separatorStrong": { "light": "#afa7b6", "dark": "#625a6f" },
      "label": { "light": "#211f25", "dark": "#e8e2ed" },
      "label2": { "light": "#59535f", "dark": "#c1b8ca" },
      "label3": { "light": "#655f6a", "dark": "#aaa0b5" },
      "control": { "light": "#f8f6f9", "dark": "#38343f" },
      "controlBorder": { "light": "#d4ced8", "dark": "#58505f" },
      "controlShadow": { "light": "0 0.5px 1px rgba(33,31,37,0.12)", "dark": "0 0.5px 1px rgba(0,0,0,0.38)" },
      "selection": { "light": "#d8d0e3", "dark": "#3b3446" },
      "selectionActive": { "light": "#d8d0e3", "dark": "#3b3446" },
      "selectionLine": { "light": "#8c7ca8", "dark": "#a294b1" },
      "onSelection": { "light": "#211f25", "dark": "#e8e2ed" }
    },
    "contrastMore": {
      "separator": { "light": "rgba(0,0,0,0.32)", "dark": "rgba(255,255,255,0.32)" },
      "separatorStrong": { "light": "rgba(0,0,0,0.5)", "dark": "rgba(255,255,255,0.5)" },
      "label2": { "light": "rgba(29,29,31,0.82)", "dark": "rgba(242,242,242,0.85)" },
      "label3": { "light": "rgba(29,29,31,0.62)", "dark": "rgba(242,242,242,0.65)" }
    }
  },
  "font": {
    "body": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, monospace"
  },
  "fontSize": {
    "caption": { "size": "11px" },
    "body": { "size": "13px", "lineHeight": "1.4" },
    "transcript": { "size": "14px", "lineHeight": "1.55" },
    "read": { "size": "16px", "lineHeight": "1.56" },
    "title": { "size": "17px" },
    "large": { "size": "36px" }
  },
  "measure": "64ch",
  "spacing": {
    "4": "4px",
    "6": "6px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "18": "18px",
    "24": "24px",
    "32": "32px",
    "48": "48px"
  },
  "radius": {
    "control": "6px",
    "card": "10px"
  },
  "motion": {
    "duration": { "fast": "120ms", "standard": "200ms" },
    "easing": { "standard": "ease-out" },
    "default": "160ms ease-out",
    "reduced": "0ms"
  },
  "layout": {
    "toolbar": "58px",
    "sidebar": "282px",
    "inspector": "320px",
    "control": { "default": "28px", "secondary": "26px", "attention": "28px" }
  }
}
