<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not a generated-Info.plist key; without it the meetings folder is absent from Files. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Lets an active meeting continue while the iPad is locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
